# ==============================================================================
# BORING APPLICATION ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================

# Supabase Production Configuration
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Frontend Vite-exposed Supabase Configuration (Public / Browser safe)
# NEVER expose SUPABASE_SERVICE_ROLE_KEY through VITE_* variables
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Application URL (for local development and password-reset redirects)
APP_URL=http://localhost:5173

# Server Port
PORT=3001

# AI Agent Configuration (when connecting Google Colab Qwen3.5-9B runtime)
REMOTE_AGENT_URL=
BORING_AGENT_AUTH_TOKEN=boring-dev-agent-token-2026
